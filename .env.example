# =============================================================================
# HiperCloudShell - Configurações de Ambiente & Integrações de IA
# =============================================================================

# Google Stitch AI UI Design (stitch.withgoogle.com)
# Obtenha sua chave em: https://stitch.withgoogle.com -> Settings -> API Keys
STITCH_API_KEY=sua_chave_do_stitch_aqui

# Endpoint oficial MCP do Google Stitch
STITCH_MCP_URL=https://stitch.googleapis.com/mcp

# Provedor padrão de execução (hybrid | claude | antigravity)
DEFAULT_LLM_PROVIDER=hybrid

# Nível de esforço padrão (high | ultracode)
DEFAULT_EFFORT_LEVEL=ultracode

# Teto financeiro de tokens de segurança por workflow
MAX_TOKENS_BUDGET=50000
